# Copy this file to `.env` (same folder) and edit. Never commit `.env`.
#   Windows PowerShell:  Copy-Item .env.example .env

# ---------------------------------------------------------------- LLM ----
# Provider: "ollama" (default, local & free) or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
# Only needed for LLM_PROVIDER=openai. Leave empty for Ollama.
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=180
# Ollama context window in tokens. Ollama's default is small and silently
# truncates long prompts, so we set it explicitly.
LLM_NUM_CTX=8192

# ---------------------------------------------------------- Embeddings ----
# "ollama"                - run `ollama pull nomic-embed-text` once (default)
# "sentence_transformers" - pip install sentence-transformers (downloads a model on first use)
# "hashing"               - built-in, offline, NOT semantic (lexical fallback for demos/tests)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Defaults to LLM_BASE_URL when empty
EMBEDDING_BASE_URL=

# ----------------------------------------------------------- Retrieval ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
# Weight of semantic score in hybrid retrieval (1.0 = semantic only, 0.0 = BM25 only)
HYBRID_ALPHA=0.6
# "Enough evidence" thresholds: a question is answerable only if some retrieved
# chunk contains >= MIN_TERM_COVERAGE of the query terms OR has a semantic
# similarity >= MIN_SEMANTIC_SCORE.
MIN_TERM_COVERAGE=0.3
MIN_SEMANTIC_SCORE=0.55
# Max characters of document text sent to the LLM in one call
MAX_CONTEXT_CHARS=12000

# ------------------------------------------------------------- Server ----
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where the SQLite DB, uploaded files and embedding cache live (default: backend/data)
DATA_DIR=
# Optional: path to a .ttf font used for PDF reports (needed for characters such as the rupee sign
# on systems without Segoe UI / Arial / DejaVu). Leave empty to auto-detect.
REPORT_FONT_PATH=
